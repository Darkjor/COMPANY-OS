{
  "name": "company-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Company OS — visual observer for Claude Code agents across projects",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run build:web && node src/server/main.ts",
    "serve": "node src/server/main.ts",
    "scan": "node src/core/cli-scan.ts",
    "dev:web": "vite web",
    "build:web": "vite build web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "hats": "node src/core/cli-hats.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
